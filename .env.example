# SMTP — cPanel (not Hostinger). Use the email account created in cPanel → Email Accounts.
# Host: usually mail.yourdomain.com (see cPanel → Email Accounts → Connect Devices)
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_SECURE=true
# Alternative: SMTP_PORT=587 and SMTP_SECURE=false (STARTTLS)
SMTP_USER=support@yourdomain.com
SMTP_PASS=your-email-account-password
SMTP_FROM=Power Trade Nexus <support@yourdomain.com>
# CORS — comma-separated allowed browser origins (member app + marketing site)
FRONTEND_URL=https://front.powertradenexus.com
# Marketing website (optional; defaults include powertradenexus.com + www)
WEBSITE_URL=https://powertradenexus.com,https://www.powertradenexus.com
EMAIL_LOGO_URL=https://front.powertradenexus.com/power-trade-nexus-logo.png
BRAND_WEBSITE_URL=https://front.powertradenexus.com
